# bench/cell/versions.env -- the ONE source of truth for the cell's pins and its
# two thresholds. KEY=value lines, no quoting, no substitution: read by the
# workflow (`cat bench/cell/versions.env >> "$GITHUB_ENV"`), by the local road
# (`. bench/cell/versions.env`) and parsed by bench/cell/cell.py.
#
# Why exact and not a range (docs/specs/M50.md D5): two pins in this repository
# have already resolved to two different compilers in two recorded runs --
# `go 1.26` in bench/go/go.mod gave go1.26.4 to the workload run and go1.26.7 to
# the soak, and DOTNET_VERSION "10.0.x" gave SDK 10.0.301 and 10.0.400. Every
# job records what the tool actually PRINTS into facts.json, so a pin that
# silently resolves to something else is visible in the artefact rather than in
# nobody's memory.

# The C reference. On the Linux cells clang is installed by version; on macos-15
# there is no other clang than Apple's and it is the one docs/comparison.md
# measured, so it is recorded as the tool prints it rather than pinned.
CLANG_APT=clang-18

GO_VERSION=1.26.7
ZIG_VERSION=0.16.0
RUST_VERSION=1.96.0
DOTNET_VERSION=10.0.400

# The repetition schedule (docs/specs/M50.md D3, § 1.3 items 1 and 5).
# Repetition 1 is recorded and excluded from every statistic: bench/results.json's
# own three runs per row have it at 1.25-1.62x the best in nine of ten rows, and
# it measures the same here -- on the phase that runs FIRST in a repetition, which
# is where the binary's pages and the 50 MB __bss sieve are first touched. Over
# the four full runs of the `all` phase: 1.28x, 1.33x, 1.56x, 1.34x median and
# 1.79x worst. The three later phases of the same repetition find them warm and
# sit at 1.01-1.12x median, which is why the cell reports the gap per phase.
REPS=7
DROP=1

# The verdict (D2): every row's ratio is median(row) / median(REFERENCE) over the
# kept repetitions of the SAME job. Absolute seconds are recorded, never gated.
REFERENCE=c-O2
PHASES=all,mix,primes,fib

# TOLERANCE -- the band two consecutive runs of the same cell must agree within,
# relative, on every row's ratio_to_reference.
#
# Measured basis (this is step 1's own job, D4). macos-arm64 on this project's
# host, Apple M4 / Darwin 25.6.0, nothing pinned because macOS has no taskset:
# THREE consecutive pairs of full runs, 11 rows x 4 phases x 7 repetitions with
# the first dropped. Worst per-row ratio drift inside a pair, and how many rows
# of that phase exceeded 5%:
#
#   phase    pair 1   pair 2   pair 3   rows over 5% (of 10, 11, 11)
#   all       2.44%    4.54%    4.76%   0, 0, 0
#   mix       4.18%    4.97%    6.49%   0, 0, 1
#   primes    3.56%    5.85%    8.36%   0, 1, 4
#   fib       3.25%    6.84%    4.98%   0, 1, 0
#
# The median row drifts 1.10-3.43% everywhere. The ABSOLUTE medians of the same
# runs drifted by up to 15.77%, and the reference row alone moved -9.34% between
# the two runs of pair 2 -- which is what § 4.4's health indicator is for, and
# why the verdict is a ratio and never a second.
#
# So 0.05 holds on the `all` phase in all three pairs with 0 violations and about
# 5% of margin on the worst row, and does NOT hold on the three short phases
# (7 of 99 rows over it, worst 8.36%): under 0.25 s the two medians in the
# quotient are each dominated by scheduler noise and their errors ADD instead of
# cancelling -- § 1.3 item 3's finding, one level down. RECOMMENDATION for step C,
# measured and not guessed: gate this band on the `all` phase and report the three
# per-phase ratios beside it (they would need about 0.10 to be gated here, and a
# pinned Linux cell may well do better). PROVISIONAL either way: measured three
# times on one host and zero times on a GitHub runner.
TOLERANCE=0.05

# REGRESS_MIN -- the floor on median(mc-plain) / median(mc-opt), the deliberately
# regressed compiler being `mc --opt=0`, which is already on main, so the teeth
# cost nothing to keep alive (D7).
#
# Applied to the phase REGRESS_PHASE names and not to the whole workload, which
# is a deviation from § 4.3 and is decided by measurement. The tooth per phase,
# the same six runs as above:
#
#   all      1.554  1.565  1.571  1.587  1.597  1.619
#   mix      2.243  2.290  2.290  2.332  2.374  2.379
#   primes   1.049  1.049  1.052  1.058  1.065  1.093
#   fib      0.996  1.005  1.014  1.025  1.036  1.037
#
# M49's allocator, peephole and hoisting move `mix` by 2.3x, `primes` by 5% and
# `fib` by nothing at all (M49 § 10 rows 2-4 say so: fib's cost is its call
# count), so `all` is a weighted average that lands at 1.55-1.62 -- above 1.5 by
# four to eight percent. On the quieter host M49 step C measured, `all` was
# 0.793 / 0.548 = 1.45, which a floor of 1.5 would fail. `mix` carries the same
# floor with 50% of margin and it is the phase the optimizer is actually about.
REGRESS_MIN=1.5
REGRESS_PHASE=mix
